    <string name="story_setup_title">Tayyorgarlik</string>
    <string name="story_setup_body">Hamma davra bo\'lib o\'tiradi. Hech kim kim ekanini bilmaydi.</string>
    <string name="story_night_title">Tun tushadi</string>
    <string name="story_night_body">Shahar uxlaydi. Mafiya jimgina uyg\'onadi.</string>
    <string name="story_mafia_title">Mafiya tanlaydi</string>
    <string name="story_mafia_body">Qorong\'uda mafiya bu tungi qurbonni jimgina ko\'rsatadi.</string>
    <string name="story_doctor_title">Shifokor harakat qiladi</string>
    <string name="story_doctor_body">Shifokor bitta o\'yinchini saqlashi mumkin — hatto o\'zini ham.</string>
    <string name="story_sheriff_title">Sherif tekshiradi</string>
    <string name="story_sheriff_body">Sherif bitta o\'yinchini tekshirib, uning kim tomonida ekanini biladi.</string>
    <string name="story_day_title">Tong otadi</string>
    <string name="story_day_body">Shahar uyg\'onadi. Mafiya tanlagan va shifokor saqlamagan o\'yinchi yo\'q.</string>
    <string name="story_vote_title">Ovoz berish</string>
    <string name="story_vote_body">Muhokama qiling. Ayblangizing. Ovoz bering — bitta o\'yinchi chiqib ketadi.</string>
    <string name="story_win_title">G\'alaba shartlari</string>
    <string name="story_win_body">Mafiya yo\'q bo\'lganda shahar g\'olib. Mafiya soni qolganlarga teng yoki ko\'p bo\'lganda — mafiya g\'olib.</string>
    <string name="story_ref_title">Qisqacha ma\'lumot</string>
    <string name="story_ref_body">Lobbida rol belgisiga bosing, uning to\'liq qobiliyatini o\'qing.</string>

    <string name="guide_create_title">Xona yarating</string>
    <string name="guide_create_body">Bosh sahifada "Xona yaratish" ni bosing.</string>
    <string name="guide_mode_title">Rejimni tanlang</string>
    <string name="guide_mode_body">Lokal — bitta telefon. LAN — har birga bittadan.</string>
    <string name="guide_roles_title">Rollarni sozlang</string>
    <string name="guide_roles_body">Har turdagi rolning sonini tanlash uchun +/− tugmasini bosing.</string>
    <string name="guide_code_title">Kodni ulashing</string>
    <string name="guide_code_body">Lobbida olti belgili kod va QR kod paydo bo\'ladi.</string>
    <string name="guide_join_title">O\'yinchilar qo\'shiladi</string>
    <string name="guide_join_body">O\'yinchilar kodni kiritadi yoki QR ni skanerlaydi. Ular lobbida paydo bo\'ladi.</string>
    <string name="guide_reveal_title">Rol ochilishi</string>
    <string name="guide_reveal_body">Har o\'yinchi kartani bosib o\'z rolini maxfiy biladi.</string>
    <string name="guide_track_title">O\'yinni kuzating</string>
    <string name="guide_track_body">Bosqich taymerini kuzating. Chiqib ketganlarni o\'yinchilar ro\'yxatida belgilang.</string>

