<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Launch theme. The app draws entirely with Jetpack Compose, so this XML
        theme only governs the window background flash before setContent runs.
        We extend a platform NoActionBar theme to avoid pulling in the View
        Material Components library just for one parent reference.
    -->
    <style name="Theme.Omerta" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
    </style>
</resources>
