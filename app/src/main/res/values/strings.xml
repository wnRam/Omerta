    <string name="story_setup_title">The setup</string>
    <string name="story_setup_body">Everyone sits in a circle. No one knows who is who.</string>
    <string name="story_night_title">Night falls</string>
    <string name="story_night_body">The city sleeps. The Mafia wakes — quietly.</string>
    <string name="story_mafia_title">Mafia chooses</string>
    <string name="story_mafia_body">In the dark, the Mafia silently picks tonight\'s target.</string>
    <string name="story_doctor_title">The Doctor acts</string>
    <string name="story_doctor_body">The Doctor may save one player — even themselves.</string>
    <string name="story_sheriff_title">Sheriff investigates</string>
    <string name="story_sheriff_body">The Sheriff checks one player and learns whose side they\'re on.</string>
    <string name="story_day_title">Day breaks</string>
    <string name="story_day_body">The town wakes. Anyone the Mafia took (and the Doctor didn\'t save) is gone.</string>
    <string name="story_vote_title">The vote</string>
    <string name="story_vote_body">Discuss. Accuse. Vote — and one player is eliminated.</string>
    <string name="story_win_title">Win conditions</string>
    <string name="story_win_body">Town wins when every Mafia is eliminated. Mafia wins when they equal or outnumber the rest.</string>
    <string name="story_ref_title">Quick reference</string>
    <string name="story_ref_body">Tap any role icon in the lobby to read its full ability.</string>

    <!-- ============ How to Play — walkthrough ============ -->
    <string name="guide_create_title">Create a Room</string>
    <string name="guide_create_body">Tap "Create Room" on the home screen.</string>
    <string name="guide_mode_title">Choose your mode</string>
    <string name="guide_mode_body">Local for one shared phone. LAN for one phone per player.</string>
    <string name="guide_roles_title">Set up roles</string>
    <string name="guide_roles_body">Tap +/− to pick how many of each role you want in play.</string>
    <string name="guide_code_title">Share the code</string>
    <string name="guide_code_body">A six-character room code and matching QR appear in the lobby.</string>
    <string name="guide_join_title">Players join</string>
    <string name="guide_join_body">Players enter the code or scan the QR. You\'ll see them appear in the lobby.</string>
    <string name="guide_reveal_title">The reveal</string>
    <string name="guide_reveal_body">Each player taps to flip their card and learns their role privately.</string>
    <string name="guide_track_title">Track the game</string>
    <string name="guide_track_body">Watch the phase timer count down. Mark eliminations from the player list.</string>

